@{
    ViewData["Title"] = "Portal del Cliente";
}

<div class="container mt-5 text-center">
    <h1 class="display-4 text-primary"><i class="bi bi-person-heart"></i> Portal del Cliente</h1>
    <p class="lead mt-3">Bienvenido. Desde aquí puedes solicitar un nuevo servicio de transporte.</p>

    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body py-5">
                    <i class="bi bi-plus-circle text-success" style="font-size: 3rem;"></i>
                    <h3 class="card-title mt-3">Nueva Solicitud</h3>
                    <p class="card-text text-muted">Programa un viaje indicando tu origen, destino y fecha.</p>
                    <a asp-controller="Solicitud" asp-action="Crear" class="btn btn-success btn-lg mt-3 w-100">Crear Solicitud</a>
                </div>
            </div>
        </div>
    </div>
</div>
