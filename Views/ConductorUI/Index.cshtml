@{
    ViewData["Title"] = "Portal del Conductor";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-steering"></i> Portal del Conductor</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">Ingresa tu número de licencia para ver los viajes que tienes asignados.</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <div class="mb-4">
                            <label for="licencia" class="form-label fw-bold">Número de Licencia</label>
                            <input type="text" class="form-control form-control-lg" id="licencia" name="licencia" placeholder="Ej: LIC-001" required />
                        </div>
                        <button type="submit" class="btn btn-dark btn-lg w-100">Ingresar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
