@model Trabajo_Software.Models.ViewModels.AsignarViewModel

@{
    ViewData["Title"] = "Asignar Conductor";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-person-plus-fill"></i> Asignar Conductor</h4>
        </div>
        <div class="card-body p-4">
            <h5 class="text-muted mb-4">Detalles de la Solicitud #@Model.Solicitud.Id</h5>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Origen:</strong> @Model.Solicitud.Origen</p>
                    <p><strong>Destino:</strong> @Model.Solicitud.Destino</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Fecha de Servicio:</strong> @Model.Solicitud.FechaServicio.ToString("dd/MM/yyyy")</p>
                    <p><strong>Estado:</strong> <span class="badge bg-success">@Model.Solicitud.Estado</span></p>
                    <p><strong>Tamaño:</strong> @Model.Solicitud.DimensionesProducto</p>
                    <p><strong>Precio Estimado:</strong> <span class="text-success fw-bold">S/ @Model.Solicitud.PrecioEstimado.ToString("0.00")</span></p>
                </div>
            </div>

            <hr />

            <form method="post" asp-action="AsignarConductor">
                <input type="hidden" name="solicitudId" value="@Model.Solicitud.Id" />
                
                <div class="mb-4 mt-3">
                    <label asp-for="ConductorId" class="form-label fw-bold">Seleccione un Conductor Disponible:</label>
                    <select asp-for="ConductorId" asp-items="Model.ConductoresDisponibles" class="form-select form-select-lg" required>
                        <option value="">-- Seleccione un conductor --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Solicitud" asp-action="Validadas" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-5"><i class="bi bi-check2-circle"></i> Asignar</button>
                </div>
            </form>
        </div>
    </div>
</div>
