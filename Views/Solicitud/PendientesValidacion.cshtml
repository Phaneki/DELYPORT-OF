@model IEnumerable<SolicitudTransporte>

@{
    ViewData["Title"] = "Validación de Solicitudes";
}

<div class="container mt-5">
    <h2 class="mb-4">Solicitudes Pendientes de Validación</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay solicitudes pendientes de validación en este momento.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover shadow-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Tamaño</th>
                        <th>Precio</th>
                        <th>Fecha y Hora</th>
                        <th>Observaciones Cliente</th>
                        <th>Estado</th>
                        <th class="text-center" style="width: 250px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Origen</td>
                            <td>@item.Destino (@item.DistritoDestino)</td>
                            <td>@item.DimensionesProducto</td>
                            <td class="text-success fw-bold">S/ @item.PrecioEstimado.ToString("0.00")</td>
                            <td>@item.FechaServicio.ToString("dd/MM/yyyy") @item.HoraServicio.ToString("HH:mm")</td>
                            <td>@(string.IsNullOrEmpty(item.Observaciones) ? "N/A" : item.Observaciones)</td>
                            <td><span class="badge bg-secondary">@item.Estado</span></td>
                            <td class="text-center">
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="text" name="observaciones" class="form-control form-control-sm mb-2" placeholder="Notas de validación (Opcional)" />
                                    <button type="submit" asp-action="Aprobar" class="btn btn-sm btn-success me-1">
                                        <i class="bi bi-check-lg"></i> Aprobar
                                    </button>
                                    <button type="submit" asp-action="Rechazar" class="btn btn-sm btn-danger">
                                        <i class="bi bi-x-lg"></i> Rechazar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
