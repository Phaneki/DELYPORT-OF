@model SolicitudTransporte

@{
    ViewData["Title"] = "Detalles de Solicitud";
    ViewData["Active"] = "Solicitud";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <!-- Encabezado -->
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary mb-3">
                    <i class="bi bi-arrow-left"></i> Volver al Listado
                </a>
                <h2 class="mb-2">
                    <i class="bi bi-receipt"></i> Solicitud #@Model.Id
                </h2>
                <p class="text-muted">Detalles completos de la solicitud de transporte</p>
            </div>

            <!-- Tarjeta Principal -->
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="mb-0">Información de la Solicitud</h5>
                        </div>
                        <div class="col-auto">
                            @if (Model.Estado == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark fs-6">@Model.Estado</span>
                            }
                            else if (Model.Estado == "Confirmada")
                            {
                                <span class="badge bg-success fs-6">@Model.Estado</span>
                            }
                            else if (Model.Estado == "Cancelada")
                            {
                                <span class="badge bg-danger fs-6">@Model.Estado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">@Model.Estado</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Sección de Ubicaciones -->
                    <div class="mb-5">
                        <h5 class="mb-3 pb-2 border-bottom">
                            <i class="bi bi-geo-fill text-danger"></i> Ubicaciones
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="p-3 bg-light rounded">
                                    <h6 class="text-muted mb-2">Punto de Origen</h6>
                                    <p class="h5 mb-0">@Model.Origen</p>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="p-3 bg-light rounded">
                                    <h6 class="text-muted mb-2">Punto de Destino</h6>
                                    <p class="h5 mb-0">@Model.Destino</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sección de Fecha y Hora -->
                    <div class="mb-5">
                        <h5 class="mb-3 pb-2 border-bottom">
                            <i class="bi bi-calendar-check text-info"></i> Programación del Servicio
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Fecha de Servicio</h6>
                                <p class="h5 mb-0">
                                    <strong>@Model.FechaServicio.ToString("dddd, dd de MMMM de yyyy", new System.Globalization.CultureInfo("es-ES"))</strong>
                                </p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Hora de Servicio</h6>
                                <p class="h5 mb-0">
                                    <strong>@Model.HoraServicio.ToString("HH:mm")</strong>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Sección de Observaciones -->
                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div class="mb-5">
                            <h5 class="mb-3 pb-2 border-bottom">
                                <i class="bi bi-chat-left-text text-success"></i> Observaciones
                            </h5>
                            <div class="p-3 bg-light rounded">
                                <p class="mb-0">@Model.Observaciones</p>
                            </div>
                        </div>
                    }

                    <!-- Sección de Datos del Sistema -->
                    <div class="mb-3">
                        <h5 class="mb-3 pb-2 border-bottom">
                            <i class="bi bi-clock-history text-secondary"></i> Información del Sistema
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Fecha de Solicitud</h6>
                                <p class="mb-0">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm:ss")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Estado Actual</h6>
                                <p class="mb-0">
                                    @if (Model.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">@Model.Estado</span>
                                    }
                                    else if (Model.Estado == "Confirmada")
                                    {
                                        <span class="badge bg-success">@Model.Estado</span>
                                    }
                                    else if (Model.Estado == "Cancelada")
                                    {
                                        <span class="badge bg-danger">@Model.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.Estado</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="row g-2">
                <div class="col-md-6">
                    <a asp-action="Crear" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-plus-circle"></i> Nueva Solicitud
                    </a>
                </div>
                <div class="col-md-6">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100">
                        <i class="bi bi-list-ul"></i> Ver Listado
                    </a>
                </div>
            </div>
        </div>

        <!-- Sidebar de Información -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0"><i class="bi bi-exclamation-circle"></i> Estado de la Solicitud</h6>
                </div>
                <div class="card-body text-center py-4">
                    @if (Model.Estado == "Pendiente")
                    {
                        <div class="alert alert-warning mb-3" role="alert">
                            <p class="mb-0">La solicitud está <strong>esperando revisión</strong></p>
                        </div>
                        <p class="text-muted small">Se le notificará cuando el estado cambie</p>
                    }
                    else if (Model.Estado == "Confirmada")
                    {
                        <div class="alert alert-success mb-3" role="alert">
                            <p class="mb-0">La solicitud ha sido <strong>confirmada</strong></p>
                        </div>
                        <p class="text-muted small">El servicio está programado para la fecha y hora indicada</p>
                    }
                    else if (Model.Estado == "Cancelada")
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            <p class="mb-0">La solicitud ha sido <strong>cancelada</strong></p>
                        </div>
                        <p class="text-muted small">Puede crear una nueva solicitud cuando lo desee</p>
                    }
                </div>
            </div>

            <!-- Información de Contacto -->
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-telephone"></i> Contacto</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-2">¿Necesita modificar esta solicitud?</p>
                    <p class="text-muted mb-3">Contáctenos con el número de solicitud:</p>
                    <p class="text-center fs-5 fw-bold text-primary">
                        #@Model.Id
                    </p>
                    <hr />
                    <p class="text-muted small mb-0">
                        <i class="bi bi-envelope"></i> contacto@transporte.com
                    </p>
                    <p class="text-muted small">
                        <i class="bi bi-telephone"></i> +34 XXX XX XX XX
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
