@model IEnumerable<Trabajo_Software.Models.SolicitudTransporte>

@{
    ViewData["Title"] = "Asignación de Conductores";
}

<div class="container mt-5">
    <h2 class="mb-4">Solicitudes Validadas (Pendientes de Asignación)</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay solicitudes validadas esperando por un conductor.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover shadow-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Fecha de Servicio</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Origen</td>
                            <td>@item.Destino</td>
                            <td>@item.FechaServicio.ToString("dd/MM/yyyy") @item.HoraServicio.ToString("HH:mm")</td>
                            <td><span class="badge bg-success">@item.Estado</span></td>
                            <td class="text-center">
                                <a asp-controller="Asignacion" asp-action="Asignar" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                    <i class="bi bi-person-plus"></i> Asignar Conductor
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
