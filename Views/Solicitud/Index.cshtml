@model IEnumerable<SolicitudTransporte>

@{
    ViewData["Title"] = "Solicitudes de Transporte";
    ViewData["Active"] = "Solicitud";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-list-check"></i> Solicitudes de Transporte Registradas</h2>
            <p class="text-muted">Gestione todas las solicitudes de transporte en el sistema</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Crear" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Nueva Solicitud
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Tabla Responsiva -->
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-hash"></i> ID</th>
                        <th><i class="bi bi-geo-fill"></i> Origen</th>
                        <th><i class="bi bi-geo-alt-fill"></i> Destino</th>
                        <th><i class="bi bi-calendar-event"></i> Fecha</th>
                        <th><i class="bi bi-clock"></i> Hora</th>
                        <th><i class="bi bi-info-circle"></i> Estado</th>
                        <th><i class="bi bi-gear"></i> Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary">@solicitud.Id</span>
                            </td>
                            <td>
                                <strong>@solicitud.Origen</strong>
                            </td>
                            <td>
                                <strong>@solicitud.Destino</strong>
                            </td>
                            <td>
                                @solicitud.FechaServicio.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @solicitud.HoraServicio.ToString("HH:mm")
                            </td>
                            <td>
                                @if (solicitud.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">@solicitud.Estado</span>
                                }
                                else if (solicitud.Estado == "Validada")
                                {
                                    <span class="badge bg-success">@solicitud.Estado</span>
                                }
                                else if (solicitud.Estado == "Rechazada")
                                {
                                    <span class="badge bg-danger">@solicitud.Estado</span>
                                }
                                else if (solicitud.Estado == "Asignado")
                                {
                                    <span class="badge bg-info text-dark">@solicitud.Estado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@solicitud.Estado</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Detalles" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-primary" title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Estadísticas -->
        <div class="row mt-4 g-3">
            <div class="col">
                <div class="card text-center h-100 shadow-sm border-primary">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-1"><i class="bi bi-files"></i> Total</h6>
                        <h3 class="text-primary fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card text-center h-100 shadow-sm border-warning">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-1"><i class="bi bi-hourglass-split text-warning"></i> Pendientes</h6>
                        <h3 class="text-warning fw-bold mb-0">@Model.Count(s => s.Estado == "Pendiente")</h3>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card text-center h-100 shadow-sm border-success">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-1"><i class="bi bi-check-circle text-success"></i> Validadas</h6>
                        <h3 class="text-success fw-bold mb-0">@Model.Count(s => s.Estado == "Validada")</h3>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card text-center h-100 shadow-sm border-info">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-1"><i class="bi bi-truck text-info"></i> Asignadas</h6>
                        <h3 class="text-info text-dark fw-bold mb-0">@Model.Count(s => s.Estado == "Asignado")</h3>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card text-center h-100 shadow-sm border-danger">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-1"><i class="bi bi-x-circle text-danger"></i> Rechazadas</h6>
                        <h3 class="text-danger fw-bold mb-0">@Model.Count(s => s.Estado == "Rechazada")</h3>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Mensaje cuando no hay solicitudes -->
        <div class="alert alert-info" role="alert">
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                <h4>No hay solicitudes de transporte registradas</h4>
                <p class="text-muted">Comience registrando una nueva solicitud</p>
                <a asp-action="Crear" class="btn btn-primary btn-lg mt-3">
                    <i class="bi bi-plus-circle"></i> Crear Nueva Solicitud
                </a>
            </div>
        </div>
    }
</div>
